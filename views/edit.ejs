
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Blog Post - My Blog</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1>My Blog</h1>
    <p>Edit your blog post.</p>
  </header>

  <main>
    <h2>Edit Blog Post</h2>

    <form action="/blogs/<%= blog.blog_id %>/edit" method="POST">
      <label for="title">Post Title</label>
      <input
        type="text"
        id="title"
        name="title"
        maxlength="255"
        value="<%= blog.title %>"
        required
      >

      <label for="body">Post Content</label>
      <textarea
        id="body"
        name="body"
        rows="8"
        required
      ><%= blog.body %></textarea>

      <button type="submit">Save Changes</button>
    </form>

    <p><a href="/">Cancel and return to blog</a></p>
  </main>
</body>
</html>
